                  "pm.test('Status code is 200 or 400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Does not meet publication guidelines.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/posts/reject/{{pendingPostId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "reject", "{{pendingPostId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. AI Content Improvement",
      "item": [
        {
          "name": "4.1 Non-Owner AI Improve Attempt (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{secondUserToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/improve/{{draftPostId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "improve", "{{draftPostId}}"]
            }
          }
        },
        {
          "name": "4.2 Owner AI Improve Draft Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Handled gracefully: 201 Created or 503 Service Unavailable if unconfigured key', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 503, 502]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test('New ID generated and saved as draft', function () {",
                  "        pm.expect(jsonData.data.improvedPost._id).to.not.eql(pm.collectionVariables.get('draftPostId'));",
                  "        pm.expect(jsonData.data.improvedPost.status).to.eql('draft');",
                  "        pm.collectionVariables.set('improvedPostId', jsonData.data.improvedPost._id);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/improve/{{draftPostId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "improve", "{{draftPostId}}"]
            }
          }
        }
      ]
    },
