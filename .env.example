# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/akatsukis-draft
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/akatsukis-draft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/akatsukis-draft

# Authentication & JWT Configuration
# Generate a strong 64-character random secret for production
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# CORS & Security
FRONTEND_URL=*

# Initial Admin Bootstrap Configuration (Optional)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@akatsuki.draft
ADMIN_PASSWORD=ChangeMeAdmin123!
